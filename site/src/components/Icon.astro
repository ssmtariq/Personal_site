} as const;
const { name, size = 20, label, class: cls } = Astro.props;
const icon = ICONS[name] as { fill?: boolean; d: string };
const paint = icon.fill
  ? { fill: 'currentColor' }
  : { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.8', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  {...paint}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.d}
/>
