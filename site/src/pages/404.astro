---
// GitHub Pages serves this file for any address that does not exist.
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/ibm-plex-sans';
import '../styles/site.css';
import { getEntry } from 'astro:content';
const me = (await getEntry('profile', 'me'))!.data;
const BASE = import.meta.env.BASE_URL;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Page not found · {me.name.full}</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
</head>
<body class="on-blue not-found">
  <main class="container">
    <p class="sec-num">404</p>
    <h1 class="sec-title">This page does not exist</h1>
    <p>Everything now lives on one page.</p>
    <p><a class="btn btn-maize" href={BASE}>Go to {me.name.full}’s site</a></p>
  </main>
</body>
</html>
